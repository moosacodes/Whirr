# ---------------------------------------------------------------------------
# Whirr configuration
# Copy to .env and fill only what you need. Every value is optional: Whirr
# runs in clearly-labelled demo metering mode without PayPal credentials.
# NEVER commit .env. All values below are server-side only.
# ---------------------------------------------------------------------------

# HTTP
WHIRR_PORT=8787
WHIRR_HOST=127.0.0.1
# Exact public origin used to build PayPal return URLs. In dev the Vite origin
# is http://localhost:5173; when serving the built app it is
# http://localhost:8787. A non-loopback production host requires this value and
# it must be HTTPS.
# WHIRR_PUBLIC_ORIGIN=http://localhost:5173
# Set to 1 only when running behind a trusted reverse proxy / tunnel.
# Do not enable this on a directly exposed server: it trusts forwarded IPs.
WHIRR_TRUST_PROXY=0

# Storage
WHIRR_DATA_DIR=data
WHIRR_DB_PATH=data/whirr.db

# Operator access. If omitted, a random key is generated once and stored in
# .whirr/operator-key. Read it with `npm run key`; it is never printed by the
# server. Require HTTPS in production and keep this value server-side only.
# WHIRR_OPERATOR_KEY=
# WHIRR_COOKIE_SECRET=
# Set to 1 to force Secure session cookies. If unset, they are Secure when
# WHIRR_PUBLIC_ORIGIN (or the primary origin) uses HTTPS. There is no
# supported way to disable Secure cookies on an HTTPS origin.
# WHIRR_COOKIE_SECURE=1

# PayPal Sandbox ONLY. Never use live credentials here.
# The app refuses any base URL that is not the PayPal Sandbox host.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required only for genuine webhook signature verification.
PAYPAL_WEBHOOK_ID=
# Optional override for tests / a local contract double. Must stay loopback
# and is rejected when NODE_ENV=production.
# PAYPAL_BASE_URL=http://127.0.0.1:9999

# Rate limits (requests per window)
WHIRR_RATE_LIMIT_PER_MINUTE=600
