{
  "name": "whirr",
  "version": "7.0.0-rc.1",
  "private": true,
  "description": "Whirr 7.0 — The Negotiated World. Request an observable change in a shared physical environment, reach a voluntary agreement, and settle only against deterministic evidence and buyer consent in PayPal Sandbox.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/server.ts",
    "setup": "tsx scripts/setup.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "train:reference": "tsx scripts/train-reference.ts",
    "eval:reference": "tsx scripts/evaluate-reference.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:promise": "tsx scripts/seed-promise.ts",
    "seed:ambient": "tsx scripts/seed-ambient.ts",
    "key": "tsx scripts/print-key.ts",
    "demo:offline": "tsx scripts/offline-demo.ts",
    "proof:verify": "tsx scripts/verify-proof.ts",
    "bench": "tsx scripts/benchmark.ts",
    "bench:query": "tsx scripts/benchmark-query.ts",
    "gate:v3": "tsx scripts/gate-v3.ts",
    "gate:a:export": "tsx scripts/export-gate-a.ts",
    "proxy:webhook": "tsx scripts/webhook-proxy.ts",
    "operator:7": "tsx scripts/operator-7.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test",
    "smoke": "tsx scripts/smoke.ts",
    "screenshots": "tsx scripts/capture-v4.ts",
    "capture:v7": "tsx scripts/capture-v7.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.2.0",
    "globals": "17.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.2",
    "vite": "^7.0.6",
    "vitest": "^4.1.12"
  }
}
